{
  "name": "@elemental/ui-kit",
  "version": "1.0.0",
  "description": "UI kit for Elemental apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate-tokens": "node ./scripts/generate-tokens.cjs",
    "storybook": "storybook dev -c ./.storybook -p 8080",
    "storybook:build": "storybook build -c ./.storybook"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "classnames": "2.5.1"
  },
  "devDependencies": {
    "@elemental/icons": "1.0.0",
    "@storybook/react-vite": "^9.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^9.1.0",
    "typescript": "~6.0.2",
    "vite": "^7.0.0"
  },
  "sideEffects": [
    "*.css",
    "*.pcss"
  ]
}
