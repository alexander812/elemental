.host {
  display: inline-flex;
  position: relative;
  box-sizing: border-box;
  min-width: 0;
}

.hostFullWidth {
  width: 100%;
}

.control {
  display: flex;
  position: relative;
  box-sizing: border-box;
  align-items: center;
  width: 100%;
  min-width: 0;
  padding: 0 40px 0 12px;
  transition: background-color 200ms ease-in-out;
  border: 1px solid var(--input-border);
  border-radius: var(--corner-radius-s);
  outline: none;
  background: var(--input-bg-default);
  color: var(--contrast-primary);
  font-family: var(--font-main);
  font-size: 1rem;
  line-height: 1.25;
  text-align: start;
  cursor: pointer;

  &:focus-visible {
    border-color: var(--accent-text-and-icons);
  }

  &:hover:not(:disabled) {
    background: var(--input-bg-hover);
  }

  &:disabled {
    background: var(--input-bg-inactive);
    color: var(--contrast-tertiary);
    cursor: not-allowed;
  }
}

.icon {
  display: inline-flex;
  position: absolute;
  top: 50%;
  right: 12px;
  transform: translateY(-50%);
  color: var(--contrast-tertiary);
  pointer-events: none;
}

.list {
  display: flex;
  flex-direction: column;
  padding: 8px;
}

.option {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  min-height: 48px;
  padding: 8px 12px;
  transition: background-color 100ms ease-in-out;
  border: none;
  border-radius: var(--corner-radius-s);
  background: none;
  color: var(--contrast-primary);
  font-family: var(--font-main);
  text-align: start;
  cursor: pointer;

  &:hover:not(:disabled) {
    background: var(--control-bg-hover);
  }

  &:active:not(:disabled) {
    background: var(--control-bg-active);
  }

  &:disabled {
    color: var(--contrast-tertiary);
    cursor: not-allowed;
  }
}

.optionSelected {
  background: var(--control-bg-active);
}

.optionIcon {
  display: inline-flex;
  flex-shrink: 0;
  color: var(--accent-text-and-icons);
}
