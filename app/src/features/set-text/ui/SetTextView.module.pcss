.root {
  display: flex;
  position: absolute;
  inset: 0;
  flex-direction: column;
}

.layout {
  display: flex;
  flex-grow: 1;
  flex-direction: column;
  gap: 12px;
  min-height: 0;
  padding: 16px;
}

.wordsScroll {
  flex-grow: 1;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding-bottom: 12px;
}

.words {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 8px;
  row-gap: 2px;
}

.word {
  padding: 3px 0;
  border: none;
  border-radius: 4px;
  background: none;
  color: var(--contrast-primary);
  font-family: var(--font-main);
  font-size: 16px;
  font-weight: 500;
  line-height: 1.5;
  text-align: start;
  cursor: pointer;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
}

.wordChecked {
  background-color: var(--accent-bg-default);
  color: var(--accent-over);
}

.tooltip {
  display: flex;
  position: fixed;
  z-index: 400;
  box-sizing: border-box;
  align-items: center;
  max-width: 240px;
  padding: 8px 12px;
  transform: translate(-50%, calc(-100% - 10px));
  border: 1px solid var(--surface-elevation-3);
  border-radius: var(--corner-radius-s);
  background-color: var(--surface-elevation-2);
  box-shadow:
    0 6px 12px -3px rgb(0 0 0, 24%),
    0 24px 24px -6px rgb(0 0 0, 12%);
  pointer-events: none;

  &::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 10px;
    height: 10px;
    transform: translateX(-50%) rotate(45deg);
    border-right: 1px solid var(--surface-elevation-3);
    border-bottom: 1px solid var(--surface-elevation-3);
    background-color: var(--surface-elevation-2);
  }
}
