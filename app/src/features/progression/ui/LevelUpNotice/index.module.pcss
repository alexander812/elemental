.overlay {
  display: flex;
  position: absolute;
  z-index: 900;
  inset: 0;
  align-items: center;
  justify-content: center;
  padding: calc(64px + env(safe-area-inset-top)) 24px calc(24px + env(safe-area-inset-bottom));
  border: none;
  color: var(--contrast-primary);
  font: inherit;
  background: var(--surface-canvas);
}
