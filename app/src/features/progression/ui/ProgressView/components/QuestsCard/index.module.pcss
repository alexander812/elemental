.row {
  display: flex;
  gap: 8px;
  align-items: center;
}

.state {
  display: inline-flex;
  flex-shrink: 0;
  width: 16px;
  color: var(--positive-text-and-icons);
}

.reward {
  display: inline-flex;
  flex-shrink: 0;
  gap: 3px;
  align-items: center;
  color: var(--contrast-secondary);
}

.rowDone {
  opacity: 0.55;
}
