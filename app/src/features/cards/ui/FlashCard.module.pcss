.cardActions {
  display: flex;
  position: absolute;
  z-index: 2;
  inset-block-end: 16px;
  inset-inline-end: 16px;
  align-items: center;
  gap: 4px;
}

.actionButton {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  padding: 0;
  transition: background-color 150ms ease-in-out;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: inherit;
  opacity: 0.75;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;

  &:active {
    background: rgb(127 127 127 / 24%);
    opacity: 1;
  }

  &:disabled {
    cursor: default;
  }
}

.actionButtonActive {
  color: var(--negative-text-and-icons);
  opacity: 1;
  animation: microphonePulse 1.2s ease-in-out infinite;
}

@keyframes microphonePulse {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.15);
  }
}
