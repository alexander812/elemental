.cardActions {
  display: flex;
  position: absolute;
  z-index: 2;
  inset-block-end: 16px;
  inset-inline-end: 16px;
  align-items: center;
  gap: 4px;
}

.actionButton {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  padding: 0;
  transition: background-color 150ms ease-in-out;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: inherit;
  opacity: 0.75;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;

  &:active {
    background: rgb(127 127 127 / 24%);
    opacity: 1;
  }

  &:disabled {
    cursor: default;
  }
}

.actionButtonActive {
  color: var(--negative-text-and-icons);
  opacity: 1;
  animation: microphonePulse 1.2s ease-in-out infinite;
}

.cardChecks {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
}

.checkButton {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  transition:
    color 150ms ease-in-out,
    border-color 150ms ease-in-out,
    background-color 150ms ease-in-out;
  border: 2px solid transparent;
  border-radius: 50%;
  background: transparent;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;

  &:active {
    background: rgb(127 127 127 / 24%);
  }

  &:disabled {
    cursor: default;
  }
}

.checkButtonIdle {
  border-color: currentColor;
  color: inherit;
  opacity: 0.6;
}

.checkButtonSuccess {
  border-color: var(--positive-text-and-icons);
  color: var(--positive-text-and-icons);
  opacity: 1;
}

.checkButtonFailure {
  border-color: var(--negative-text-and-icons);
  color: var(--negative-text-and-icons);
  opacity: 1;
}

.checkButtonPulse {
  animation: microphonePulse 1.2s ease-in-out infinite;
}

.checkForm {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 300px;
  gap: 8px;
}

.checkInput {
  flex: 1;
  min-width: 0;
  height: 40px;
  padding: 0 12px;
  border: 2px solid var(--contrast-quaternary);
  border-radius: 10px;
  outline: none;
  background: var(--surface-elevation-1);
  color: var(--contrast-primary);
  font-family: var(--font-main);
  font-size: 16px;
  font-weight: 500;

  &:focus {
    border-color: var(--accent-bg-default);
  }
}

@keyframes microphonePulse {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.15);
  }
}
