.preview {
  position: relative;
  display: block;
  width: 100%;
  height: 300px;
  overflow: hidden;
  background: #050505;
  color: #fff;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.poster {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
}

.scrim {
  position: absolute;
  inset: 0;
  background: rgb(5 5 5 / 55%);
}

.playBadge {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: rgb(255 255 255 / 16%);
  backdrop-filter: blur(4px);
}

.title {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16px;
}
