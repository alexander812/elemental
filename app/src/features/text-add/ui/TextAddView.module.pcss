.root {
  display: flex;
  position: absolute;
  inset: 0;
  flex-direction: column;
}

.layout {
  display: flex;
  flex-grow: 1;
  flex-direction: column;
  min-height: 0;
  padding: 16px 16px 0;
}

.inputScroll {
  flex-grow: 1;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding-bottom: 16px;
}

.wordsScroll {
  flex-grow: 1;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding-bottom: 12px;
}

.words {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 8px;
  row-gap: 2px;
}

.word {
  padding: 3px 0;
  border: none;
  border-radius: 4px;
  background: none;
  color: var(--contrast-primary);
  font-family: var(--font-main);
  font-size: 16px;
  font-weight: 500;
  line-height: 1.5;
  text-align: start;
  cursor: pointer;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
}

.wordChecked {
  background-color: var(--accent-bg-default);
  color: var(--accent-over);
}

.footer {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  gap: 12px;
  padding: 12px 0 16px;
}
