.row {
  position: relative;
  height: 64px;
}

.reveal {
  display: flex;
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 144px;
  overflow: hidden;
  border-radius: 12px;
}

.action {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  cursor: pointer;
}

.deleteAction {
  background: var(--negative-bg-default);
  color: var(--negative-over);
}

.editAction {
  background: var(--accent-bg-default);
  color: var(--accent-over);
}

.content {
  position: relative;
  z-index: 1;
  height: 100%;
  user-select: none;
  -webkit-user-select: none;
}
